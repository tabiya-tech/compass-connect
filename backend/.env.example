# Taxonomy database settings
TAXONOMY_MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>/?retryWrites=true&w=majority&appName=Compass-Dev
TAXONOMY_DATABASE_NAME=compass-dev
TAXONOMY_MODEL_ID=taxonomy-model-id

# Application database settings
APPLICATION_MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>/?retryWrites=true&w=majority&appName=Compass-Dev
APPLICATION_DATABASE_NAME=compass-dev

# Metrics settings
METRICS_MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>/?retryWrites=true&w=majority&appName=Compass-Dev
METRICS_DATABASE_NAME=compass-dev
BACKEND_ENABLE_METRICS=False

# Users database settings
USERDATA_MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>/?retryWrites=true&w=majority&appName=Compass-Dev
USERDATA_DATABASE_NAME=compass-dev

# Career Explorer database settings (conversations + sector chunks)
CAREER_EXPLORER_MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>/?retryWrites=true&w=majority&appName=Compass-Dev
CAREER_EXPLORER_DATABASE_NAME=compass-career-explorer
# CAREER_EXPLORER_CONFIG={"sectors":[{"name":"Agriculture","description":"...","file":"agriculture.md"}],"country":"Zambia"}

# Google Cloud Platform settings
GOOGLE_APPLICATION_CREDENTIALS=keys/credentials.json
# Region for the embeddings model (text-embedding-005 etc.). Must be a regional location
# (e.g. us-central1) — these models are not published in the global publisher catalog.
VERTEX_API_EMBEDDINGS_REGION=us-central1
# Region for generative-AI calls (Gemini etc.). Can be a regional location or "global".
VERTEX_API_GEN_AI_REGION=us-central1
EMBEDDINGS_SERVICE_NAME=GOOGLE-VERTEX-AI
# See https://cloud.google.com/vertex-ai/generative-ai/docs/embeddings/get-text-embeddings#supported-models e.g.:
#   text-embedding-005
#   textembedding-gecko@003
EMBEDDINGS_MODEL_NAME=text-embedding-005

# Sentry settings
BACKEND_SENTRY_DSN=https://
BACKEND_ENABLE_SENTRY=False
# For supported options see: app.sentry_init.BackendSentryConfig
BACKEND_SENTRY_CONFIG='{"tracesSampleRate": 0.2, "enableLogs": false, "logLevel": "info", "eventLevel": "error"}'

# LLM tracing (Langfuse) settings - see backend/README.md "LLM tracing"
BACKEND_ENABLE_TRACING=False
# Point this at a self-hosted instance (e.g. http://localhost:3000) for deployments whose prompts
# carry user PII. https://cloud.langfuse.com is the managed EU/US cloud.
BACKEND_LANGFUSE_HOST=https://cloud.langfuse.com
BACKEND_LANGFUSE_PUBLIC_KEY=pk-lf-
# Never commit a real value; in deployed environments this is provisioned as a secret.
BACKEND_LANGFUSE_SECRET_KEY=sk-lf-
# For supported options see: common_libs.observability.config.TracingConfig
BACKEND_TRACING_CONFIG='{"turnSampleRate": 1.0, "pipelineSampleRate": 0.2, "maskPii": true, "maxPayloadChars": 10000, "splitJobMatching": false}'

# Country settings
DEFAULT_COUNTRY_OF_USER=Unspecified

# Settings for local development,
LOG_CONFIG_FILE=logging.cfg.dev.yaml

FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://0.0.0.0:8080
TARGET_ENVIRONMENT_TYPE=local
TARGET_ENVIRONMENT_NAME=local

# When true, bypasses registration code validation for authenticated users
GLOBAL_DISABLE_REGISTRATION_CODE=False

# Other features configurations
BACKEND_FEATURES='{}'

# Configuration for the experience pipeline
BACKEND_EXPERIENCE_PIPELINE_CONFIG={"number_of_clusters": 5, "number_of_top_skills_to_pick_per_cluster": 1}

# CV storage and limits (optional; required to persist uploads)
GLOBAL_ENABLE_CV_UPLOAD=<True/False>
BACKEND_CV_STORAGE_BUCKET=<GCS_BUCKET_NAME>
BACKEND_CV_MAX_UPLOADS_PER_USER=<INTEGER>
BACKEND_CV_RATE_LIMIT_PER_MINUTE=<INTEGER>


# Locales
BACKEND_LANGUAGE_CONFIG='{"default_locale":"en-US","available_locales":[{"locale":"en-US","date_format":"MM/DD/YYYY"}]}'

# Branding settings
GLOBAL_PRODUCT_NAME=Compass

# Matching service (optional; required for external matching integration)
MATCHING_SERVICE_URL=<URL>
MATCHING_SERVICE_API_KEY=<API_KEY>

# Phase transition behavior (optional; set to 1 or true to enable inline phase transitions)
COMPASS_INLINE_PHASE_TRANSITION=

# LLM provider selection
# Choose which LLM backend all agents use. Defaults to "gemini".
#   gemini     — Vertex AI / Gemini (requires GOOGLE_APPLICATION_CREDENTIALS above)
#   anthropic  — Anthropic Claude API (requires ANTHROPIC_API_KEY below)
#   ollama     — Local model via ollama (requires ollama running; see OLLAMA_BASE_URL)
LLM_PROVIDER=gemini

# Override the model name for the selected provider (optional).
# When unset, each provider uses its own default:
#   gemini:    gemini-2.5-flash-lite
#   anthropic: claude-sonnet-4-6
#   ollama:    qwen2.5:7b
# LLM_MODEL_NAME=

# Anthropic API key — required when LLM_PROVIDER=anthropic. Treat as a secret; never commit a real value.
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama server URL — only needed when LLM_PROVIDER=ollama (defaults to localhost).
# OLLAMA_BASE_URL=http://localhost:11434

# Zambia jobs database
JOBS_MONGODB_URI=<MONGODB_URI>
JOBS_DATABASE_NAME=<DATABASE_NAME>
JOBS_COLLECTION_NAME=<COLLECTION_NAME>

# Local-dev only: set this when GOOGLE_CLOUD_PROJECT points at a different project than the one hosting
# the admin Identity Platform tenant 
ADMIN_FIREBASE_TENANT_ID=<ADMIN_FIREBASE_TENANT_ID>
