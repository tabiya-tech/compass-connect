FROM python:3.11-slim AS builder

# The lock file is generated by Poetry 2.1.x
RUN pip install poetry==2.1.4

RUN poetry config virtualenvs.create false

WORKDIR /code

COPY ./pyproject.toml ./README.md ./poetry.lock* ./

RUN poetry install --no-interaction --no-ansi --no-root --without dev

# Generate the offline vignettes (gitignored, so absent from a fresh clone). The script is self-contained,
# needs no cloud access, and takes about a minute.
COPY ./app/agent/preference_elicitation_agent/offline_optimization ./offline_optimization
RUN python offline_optimization/run_offline_optimization.py \
    --output-dir offline_output \
    --config offline_optimization/preference_parameters.json

## Second stage to build the final image with a smaller image size

FROM python:3.11-slim

# Copy the dependencies from the builder image
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin/uvicorn /usr/local/bin/uvicorn

WORKDIR /code

COPY ./app ./app
COPY ./features ./features
COPY ./common_libs ./common_libs
COPY --from=builder /code/offline_output ./offline_output
COPY ./scripts/verify_setup.py ./scripts/verify_setup.py

RUN useradd --system --no-create-home appuser && chown -R appuser /code
USER appuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/docs', timeout=4)"

CMD exec uvicorn app.server:app --host 0.0.0.0 --port 8080
