# Compass Connect on-premise: the single configuration file for the whole stack.
# Copy to .env and fill in the REQUIRED section. Everything else has a working default.

# ============================ REQUIRED ============================

# Password mongot (the search engine) uses to talk to MongoDB. Any strong string without spaces.
MONGOT_PASSWORD=

# Path (on the host) to the Google Cloud service-account key (roles: aiplatform.user, dlp.user)
GCP_CREDENTIALS_FILE=./backend/keys/credentials.json

# Firebase web app config (Firebase console -> Project settings -> Your apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
# The Firebase project id (Project settings -> General -> Project ID). The backend only accepts tokens issued for it.
FIREBASE_PROJECT_ID=

# RSA public key (single line, no BEGIN/END lines) used to encrypt sensitive personal data in the browser
SENSITIVE_PERSONAL_DATA_RSA_ENCRYPTION_KEY=
SENSITIVE_PERSONAL_DATA_RSA_ENCRYPTION_KEY_ID=local-1

# Where users reach the app. BACKEND_URL is what the BROWSER uses to reach the backend.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# ============================ TAXONOMY ============================
# On the first start the stack downloads a public taxonomy export (CSV .zip), imports it and generates its embeddings
# with Vertex AI (billed to your Google Cloud project), then creates the vector search indexes. Later starts skip it.
# The list of taxonomies is at https://taxonomy.tabiya.tech/#/modeldirectory (copy the link of the .zip).
TAXONOMY_URL=https://taxonomy.tabiya.tech/downloads/68933862382aab4c7de13ec6-export-68933d936429802108f5b9af.zip
# Must be the id at the start of the file name in TAXONOMY_URL (checked at start-up)
TAXONOMY_MODEL_ID=68933862382aab4c7de13ec6
# partial: all occupations and the TAXONOMY_SKILLS_LIMIT most used skills (about 7 minutes and 10-40 US cents of Vertex AI
# for the English taxonomy). full: the whole taxonomy (longer and more expensive; not measured yet).
TAXONOMY_MODE=partial
# TAXONOMY_SKILLS_LIMIT=5500
TAXONOMY_DATABASE_NAME=compass-taxonomy

# ============================ BACKEND =============================
# How the requests reach the backend.
# "direct": nothing is in front of the backend (this stack); it verifies the Firebase ID tokens itself (needs FIREBASE_PROJECT_ID),
#   accepts only the API_KEYS and limits the requests per client IP.
# "gateway" (the default when not set): the backend is behind the Google API Gateway, which does all that. With
#   TARGET_ENVIRONMENT_TYPE=local the tokens are then not verified at all: only for testing on your own machine.
INGRESS_MODE=direct
TARGET_ENVIRONMENT_TYPE=local
TARGET_ENVIRONMENT_NAME=local

# Keys (comma separated) accepted in the `x-api-key` header by the server-to-server endpoints (/analytics/*, the
# occupation and skill search endpoints, and /integration/users).
# Leave empty to disable those endpoints. Generate with: openssl rand -hex 32
API_KEYS=

# How long a hand-off link from /integration/users can be used, in minutes (default 1440 = 24 h)
BACKEND_HANDOFF_LINK_TTL_MINUTES=1440

# Origins (comma separated, e.g. https://partner.example.org) the `return_url` of /integration/users can point to: where
# the "back" button sends the user when they are done. https only, http for localhost. Empty: return_url is refused.
BACKEND_INTEGRATION_RETURN_URL_ORIGINS=

# Whether Compass notifies the `webhook_url` of /integration/users when a user finishes their conversation (default
# false). Off: a webhook_url is refused and nothing is sent.
BACKEND_INTEGRATION_WEBHOOKS_ENABLED=false
# Origins (comma separated, e.g. https://api.partner.example.org) the `webhook_url` can point to. Required when
# webhooks are enabled. https only, http for localhost.
BACKEND_INTEGRATION_WEBHOOK_URL_ORIGINS=

# Requests per minute allowed per client IP (INGRESS_MODE=direct only), 0 disables the rate limiter.
# Raise it when many users share one IP, e.g. a school or an office behind a NAT.
BACKEND_RATE_LIMIT_PER_MINUTE=600
# If you put your own reverse proxy in front of the backend, set its IP here so the rate limiter sees the real client IPs
# (from X-Forwarded-For) instead of counting every user as the proxy.
# FORWARDED_ALLOW_IPS=
# stdout logging (the dev config writes a log file, which a container should not)
LOG_CONFIG_FILE=logging.cfg.yaml

APPLICATION_DATABASE_NAME=compass-application
USERDATA_DATABASE_NAME=compass-userdata
METRICS_DATABASE_NAME=compass-metrics
BACKEND_ENABLE_METRICS=True
CAREER_EXPLORER_DATABASE_NAME=compass-career-explorer
JOBS_DATABASE_NAME=compass-jobs
JOBS_COLLECTION_NAME=jobs

LLM_PROVIDER=gemini
EMBEDDINGS_SERVICE_NAME=GOOGLE-VERTEX-AI
EMBEDDINGS_MODEL_NAME=text-embedding-005
VERTEX_API_EMBEDDINGS_REGION=us-central1
VERTEX_API_GEN_AI_REGION=global

BACKEND_ENABLE_SENTRY=False
BACKEND_ENABLE_TRACING=False
DEFAULT_COUNTRY_OF_USER=Unspecified
GLOBAL_PRODUCT_NAME=Compass
BACKEND_FEATURES='{}'
BACKEND_EXPERIENCE_PIPELINE_CONFIG='{"number_of_clusters": 5, "number_of_top_skills_to_pick_per_cluster": 1}'
BACKEND_LANGUAGE_CONFIG='{"default_locale":"en-US","available_locales":[{"locale":"en-US","date_format":"MM/DD/YYYY"}]}'

# These two must exist (even empty) or the backend fails at start-up
MATCHING_SERVICE_URL=
MATCHING_SERVICE_API_KEY=

# ============================ FRONTEND ============================
# Must match the backend values above
GLOBAL_DISABLE_REGISTRATION_CODE=True
GLOBAL_DISABLE_LOGIN_CODE=True
GLOBAL_ENABLE_CV_UPLOAD=false
FRONTEND_SUPPORTED_LOCALES=["en-US"]
FRONTEND_DEFAULT_LOCALE=en-US
FRONTEND_ENABLE_SENTRY=false
FRONTEND_GTM_ENABLED=false
FRONTEND_ENABLE_METRICS=true

# ============================ PORTS ===============================
FRONTEND_PORT=3000
BACKEND_PORT=8080
